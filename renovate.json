{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "pin",
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    },
    {
      "matchPackageNames": [
        "/^Jellyfin\\./",
        "jellyfin/jellyfin"
      ],
      "allowedVersions": "/^12(?:\\.|$)/",
      "groupName": "Jellyfin 12"
    }
  ]
}
